{
  "name": "moyu",
  "version": "0.4.0",
  "private": true,
  "description": "moyu: a novel reader that hides in plain sight inside Claude Code.",
  "type": "module",
  "scripts": {
    "typecheck": "npx --yes --package typescript@5 tsc -p .",
    "validate": "claude plugin validate .",
    "test:plugin": "claude plugin test .",
    "test": "npm run typecheck && npm run validate && npm run test:plugin",
    "icon": "node scripts/make-icon.mjs"
  },
