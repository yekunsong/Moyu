  "author": "moyu contributors",
  "homepage": "https://github.com/yekunsong/Moyu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yekunsong/Moyu.git"
  },
  "bugs": {
    "url": "https://github.com/yekunsong/Moyu/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "novel-reader",
    "terminal",
    "tui",
    "boss-key",
    "reading",
    "productivity"
  ],
  "engines": {
    "node": ">=22"
  }
